# Primary LLM: Groq (Ultra-fast cloud inference, free tier)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback LLM: Google Gemini (Free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Default provider order: "groq" (primary) -> "gemini" (fallback) -> "mock" (offline)
LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=gemini

# Local Embedding Model (Runs on CPU locally, 0 API cost)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage paths
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
PDF_STORAGE_DIR=./data/papers

# Retrieval & Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=4
